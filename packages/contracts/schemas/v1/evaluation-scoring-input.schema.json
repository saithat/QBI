        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "case_id",
        "dimensions",
        "reference"
      ],
      "title": "EvaluationReferenceCase",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "ModelIdentifier": {
      "additionalProperties": false,
      "properties": {
        "kind": {
