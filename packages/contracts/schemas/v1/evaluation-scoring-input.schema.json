    "PredictedFieldObservation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence_artifact_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Artifact Ids",
          "type": "array"
        },
        "field_path": {
          "maxLength": 1000,
          "pattern": "^(?:/(?:[^/~]|~[01])+)*$",
          "title": "Field Path",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "value_json": {
          "minLength": 1,
          "title": "Value Json",
          "type": "string"
        }
      },
      "required": [
        "field_path",
        "value_json"
      ],
      "title": "PredictedFieldObservation",
      "type": "object"
    },
    "PredictedNumericalObservation": {
