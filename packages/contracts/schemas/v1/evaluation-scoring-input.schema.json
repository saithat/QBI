{
  "$defs": {
    "BoundingRegion": {
      "additionalProperties": false,
      "description": "A rectangle expressed in immutable source-image pixel coordinates.",
      "properties": {
        "canvas_height": {
          "exclusiveMinimum": 0,
          "title": "Canvas Height",
          "type": "integer"
        },
        "canvas_width": {
          "exclusiveMinimum": 0,
          "title": "Canvas Width",
          "type": "integer"
        },
        "coordinate_space": {
          "const": "source_pixels",
          "default": "source_pixels",
          "title": "Coordinate Space",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "region_id": {
          "format": "uuid",
          "title": "Region Id",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_artifact_id": {
          "format": "uuid",
          "title": "Source Artifact Id",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "region_id",
        "source_artifact_id",
        "x",
        "y",
        "width",
        "height",
        "canvas_width",
        "canvas_height"
      ],
      "title": "BoundingRegion",
      "type": "object"
    },
    "EvaluationCaseDimensions": {
      "additionalProperties": false,
      "properties": {
        "assay_layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "journal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_type": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "source_type",
        "review_status"
      ],
      "title": "EvaluationCaseDimensions",
      "type": "object"
    },
    "EvaluationDatasetSnapshot": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "$ref": "#/$defs/EvaluationReferenceCase"
          },
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        },
        "content_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "dataset_name": {
          "$ref": "#/$defs/Identifier"
        },
        "dataset_version": {
          "$ref": "#/$defs/Identifier"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "dataset_name",
        "dataset_version",
        "content_sha256",
        "frozen_at",
        "cases"
      ],
      "title": "EvaluationDatasetSnapshot",
      "type": "object"
    },
    "EvaluationGroupDimension": {
      "enum": [
        "source_type",
        "journal",
        "repository",
        "image_quality",
        "assay_layout",
        "review_status",
        "model_version",
        "pipeline_version"
      ],
      "title": "EvaluationGroupDimension",
      "type": "string"
    },
    "EvaluationMetricConfiguration": {
      "additionalProperties": false,
      "properties": {
        "bounding_box_iou_threshold": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Bounding Box Iou Threshold",
          "type": "number"
        },
        "calibration_bins": {
          "default": 10,
          "maximum": 100,
          "minimum": 2,
          "title": "Calibration Bins",
          "type": "integer"
        },
        "confidence_thresholds": {
          "default": [
            0.0,
            0.25,
            0.5,
            0.75,
            0.9
          ],
          "items": {
            "type": "number"
          },
          "title": "Confidence Thresholds",
          "type": "array"
        },
        "group_by": {
          "default": [
            "source_type",
            "journal",
            "repository",
            "image_quality",
            "assay_layout",
            "review_status",
            "model_version",
            "pipeline_version"
          ],
          "items": {
            "$ref": "#/$defs/EvaluationGroupDimension"
          },
          "title": "Group By",
          "type": "array"
        },
        "normalized_string_casefold": {
          "default": true,
          "title": "Normalized String Casefold",
          "type": "boolean"
        },
        "numerical_absolute_tolerance": {
          "default": 0.01,
          "minimum": 0,
          "title": "Numerical Absolute Tolerance",
          "type": "number"
        },
        "ranking_k": {
          "default": 10,
          "maximum": 1000,
          "minimum": 1,
          "title": "Ranking K",
          "type": "integer"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "title": "EvaluationMetricConfiguration",
      "type": "object"
    },
    "EvaluationReferenceCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "dimensions": {
          "$ref": "#/$defs/EvaluationCaseDimensions"
        },
        "reference": {
          "$ref": "#/$defs/ReferenceObservationDocument"
