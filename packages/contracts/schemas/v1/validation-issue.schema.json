{
  "$defs": {
    "Identifier": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "ValidationSeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "ValidationSeverity",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:validation-issue",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "$ref": "#/$defs/Identifier"
    },
    "evidence_artifact_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Artifact Ids",
      "type": "array"
    },
    "field_path": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field Path"
    },
    "issue_id": {
      "format": "uuid",
      "title": "Issue Id",
      "type": "string"
    },
    "message": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "severity": {
      "$ref": "#/$defs/ValidationSeverity"
    }
  },
  "required": [
    "issue_id",
    "severity",
    "code",
    "message"
  ],
  "title": "ValidationIssue",
  "type": "object"
}
