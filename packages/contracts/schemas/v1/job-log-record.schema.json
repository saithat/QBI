{
  "$defs": {
    "JobLogStream": {
      "enum": [
        "stdout",
        "stderr",
        "system"
      ],
      "title": "JobLogStream",
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:job-log-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "format": "uuid",
      "title": "Attempt Id",
      "type": "string"
    },
    "content": {
      "maxLength": 262144,
      "title": "Content",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "log_id": {
      "format": "uuid",
      "title": "Log Id",
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "stream": {
      "$ref": "#/$defs/JobLogStream"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "log_id",
    "attempt_id",
    "sequence",
    "stream",
    "content",
    "created_at"
  ],
  "title": "JobLogRecord",
  "type": "object"
}
