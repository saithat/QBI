{
  "$defs": {
    "AdjudicationEvidenceOverlay": {
      "additionalProperties": false,
      "properties": {
        "adjudication_id": {
          "format": "uuid",
          "title": "Adjudication Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "linked_field_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Linked Field Keys",
          "type": "array"
        },
        "overlay_id": {
          "format": "uuid",
          "title": "Overlay Id",
          "type": "string"
        },
        "overlay_source": {
          "const": "adjudication",
          "default": "adjudication",
          "title": "Overlay Source",
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/BoundingRegion"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_artifact_id": {
          "format": "uuid",
          "title": "Source Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "overlay_id",
        "source_artifact_id",
        "region",
        "adjudication_id",
        "revision_id"
      ],
      "title": "AdjudicationEvidenceOverlay",
      "type": "object"
    },
    "BoundingRegion": {
      "additionalProperties": false,
      "description": "A rectangle expressed in immutable source-image pixel coordinates.",
      "properties": {
        "canvas_height": {
          "exclusiveMinimum": 0,
          "title": "Canvas Height",
          "type": "integer"
        },
        "canvas_width": {
          "exclusiveMinimum": 0,
          "title": "Canvas Width",
          "type": "integer"
        },
        "coordinate_space": {
          "const": "source_pixels",
          "default": "source_pixels",
          "title": "Coordinate Space",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "region_id": {
          "format": "uuid",
          "title": "Region Id",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_artifact_id": {
          "format": "uuid",
          "title": "Source Artifact Id",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "region_id",
        "source_artifact_id",
        "x",
        "y",
        "width",
        "height",
        "canvas_width",
        "canvas_height"
      ],
      "title": "BoundingRegion",
      "type": "object"
    },
    "PredictionEvidenceOverlay": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "linked_field_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Linked Field Keys",
          "type": "array"
        },
        "overlay_id": {
          "format": "uuid",
          "title": "Overlay Id",
          "type": "string"
        },
        "overlay_source": {
          "const": "prediction",
          "default": "prediction",
          "title": "Overlay Source",
          "type": "string"
        },
        "prediction_id": {
          "format": "uuid",
          "title": "Prediction Id",
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/BoundingRegion"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_artifact_id": {
          "format": "uuid",
          "title": "Source Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "overlay_id",
        "source_artifact_id",
        "region",
        "prediction_id"
      ],
      "title": "PredictionEvidenceOverlay",
      "type": "object"
    },
    "ReviewerEvidenceOverlay": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "format": "uuid",
          "title": "Annotation Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "linked_field_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Linked Field Keys",
          "type": "array"
        },
        "overlay_id": {
          "format": "uuid",
          "title": "Overlay Id",
          "type": "string"
        },
        "overlay_source": {
          "const": "reviewer",
          "default": "reviewer",
          "title": "Overlay Source",
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/BoundingRegion"
        },
        "reviewer_id": {
          "format": "uuid",
          "title": "Reviewer Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_artifact_id": {
          "format": "uuid",
          "title": "Source Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "overlay_id",
        "source_artifact_id",
        "region",
        "annotation_id",
        "revision_id",
        "reviewer_id"
      ],
      "title": "ReviewerEvidenceOverlay",
      "type": "object"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:evidence-overlay",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "adjudication": "#/$defs/AdjudicationEvidenceOverlay",
      "prediction": "#/$defs/PredictionEvidenceOverlay",
      "reviewer": "#/$defs/ReviewerEvidenceOverlay"
    },
    "propertyName": "overlay_source"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PredictionEvidenceOverlay"
    },
    {
      "$ref": "#/$defs/ReviewerEvidenceOverlay"
    },
    {
      "$ref": "#/$defs/AdjudicationEvidenceOverlay"
    }
  ]
}
