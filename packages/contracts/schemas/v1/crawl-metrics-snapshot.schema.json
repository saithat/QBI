{
  "$defs": {
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:crawl-metrics-snapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_workers": {
      "minimum": 0,
      "title": "Active Workers",
      "type": "integer"
    },
    "bytes_downloaded": {
      "minimum": 0,
      "title": "Bytes Downloaded",
      "type": "integer"
    },
    "completed_fetches": {
      "minimum": 0,
      "title": "Completed Fetches",
      "type": "integer"
    },
    "dead_letter_count": {
      "minimum": 0,
      "title": "Dead Letter Count",
      "type": "integer"
    },
    "deduplicated_artifacts": {
      "minimum": 0,
      "title": "Deduplicated Artifacts",
      "type": "integer"
    },
    "fetch_latency_milliseconds_sum": {
      "minimum": 0,
      "title": "Fetch Latency Milliseconds Sum",
      "type": "integer"
    },
    "http_status_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Http Status Counts",
      "type": "object"
    },
    "leased_tasks": {
      "minimum": 0,
      "title": "Leased Tasks",
      "type": "integer"
    },
    "measured_at": {
      "format": "date-time",
      "title": "Measured At",
      "type": "string"
    },
    "queue_depth": {
      "minimum": 0,
      "title": "Queue Depth",
      "type": "integer"
    },
    "retry_count": {
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "source_error_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Source Error Counts",
      "type": "object"
    }
  },
  "required": [
    "measured_at",
    "queue_depth",
    "leased_tasks",
    "active_workers",
    "retry_count",
    "dead_letter_count",
    "completed_fetches",
    "bytes_downloaded",
    "deduplicated_artifacts",
    "fetch_latency_milliseconds_sum"
  ],
  "title": "CrawlMetricsSnapshot",
  "type": "object"
}
