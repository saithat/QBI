{
  "$defs": {
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "SemanticAnnotationDiff": {
      "additionalProperties": false,
      "properties": {
        "annotation_value_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotation Value Json"
        },
        "field_path": {
          "maxLength": 2000,
          "pattern": "^/",
          "title": "Field Path",
          "type": "string"
        },
        "prediction_value_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prediction Value Json"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "status": {
          "$ref": "#/$defs/SemanticDiffStatus"
        }
      },
      "required": [
        "field_path",
        "status"
      ],
      "title": "SemanticAnnotationDiff",
      "type": "object"
    },
    "SemanticDiffStatus": {
      "enum": [
        "added",
        "removed",
        "modified",
        "unchanged"
      ],
      "title": "SemanticDiffStatus",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:structured-annotation-comparison",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "added_count": {
      "minimum": 0,
      "title": "Added Count",
      "type": "integer"
    },
    "annotation_revision_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annotation Revision Id"
    },
    "differences": {
      "items": {
        "$ref": "#/$defs/SemanticAnnotationDiff"
      },
      "title": "Differences",
      "type": "array"
    },
    "modified_count": {
      "minimum": 0,
      "title": "Modified Count",
      "type": "integer"
    },
    "prediction_id": {
      "format": "uuid",
      "title": "Prediction Id",
      "type": "string"
    },
    "removed_count": {
      "minimum": 0,
      "title": "Removed Count",
      "type": "integer"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "unchanged_count": {
      "minimum": 0,
      "title": "Unchanged Count",
      "type": "integer"
    }
  },
  "required": [
    "prediction_id",
    "differences",
    "added_count",
    "removed_count",
    "modified_count",
    "unchanged_count"
  ],
  "title": "StructuredAnnotationComparison",
  "type": "object"
}
