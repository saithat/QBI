{
  "$defs": {
    "Identifier": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "ModelIdentifier": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "model",
          "default": "model",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "provider": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "version": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "provider",
        "name",
        "version"
      ],
      "title": "ModelIdentifier",
      "type": "object"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "ToolIdentifier": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tool",
          "default": "tool",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "version": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolIdentifier",
      "type": "object"
    }
  },
  "$id": "urn:hiveblot:schema:v1:search-index-configuration-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_limit": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Candidate Limit",
      "type": "integer"
    },
    "configuration_id": {
      "format": "uuid",
      "title": "Configuration Id",
      "type": "string"
    },
    "configuration_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "configuration_version": {
      "$ref": "#/$defs/Identifier"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "format": "uuid",
      "title": "Created By",
      "type": "string"
    },
    "embedding_dimensions": {
      "maximum": 4096,
      "minimum": 8,
      "title": "Embedding Dimensions",
      "type": "integer"
    },
    "embedding_model": {
      "$ref": "#/$defs/ModelIdentifier"
    },
    "index_name": {
      "$ref": "#/$defs/Identifier"
    },
    "lexical_weight": {
      "maximum": 1,
      "minimum": 0,
      "title": "Lexical Weight",
      "type": "number"
    },
    "reranker": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolIdentifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reranker_weight": {
      "default": 0.0,
      "maximum": 0.5,
      "minimum": 0,
      "title": "Reranker Weight",
      "type": "number"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "semantic_weight": {
      "maximum": 1,
      "minimum": 0,
      "title": "Semantic Weight",
      "type": "number"
    }
  },
  "required": [
    "configuration_id",
    "index_name",
    "configuration_version",
    "embedding_model",
    "embedding_dimensions",
    "lexical_weight",
    "semantic_weight",
    "candidate_limit",
    "configuration_sha256",
    "created_by",
    "created_at"
  ],
  "title": "SearchIndexConfigurationRecord",
  "type": "object"
}
