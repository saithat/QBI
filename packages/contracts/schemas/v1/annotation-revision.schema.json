{
  "$defs": {
    "AnnotationRelationship": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "format": "uuid",
          "title": "Object Id",
          "type": "string"
        },
        "relation_type": {
          "$ref": "#/$defs/Identifier"
        },
        "relationship_id": {
          "format": "uuid",
          "title": "Relationship Id",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "subject_id": {
          "format": "uuid",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "relationship_id",
        "subject_id",
        "relation_type",
        "object_id"
      ],
      "title": "AnnotationRelationship",
      "type": "object"
    },
    "AnnotationScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "BoundingRegion": {
      "additionalProperties": false,
      "description": "A rectangle expressed in immutable source-image pixel coordinates.",
      "properties": {
        "canvas_height": {
          "exclusiveMinimum": 0,
          "title": "Canvas Height",
          "type": "integer"
        },
        "canvas_width": {
          "exclusiveMinimum": 0,
          "title": "Canvas Width",
          "type": "integer"
        },
        "coordinate_space": {
          "const": "source_pixels",
          "default": "source_pixels",
          "title": "Coordinate Space",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "region_id": {
          "format": "uuid",
          "title": "Region Id",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_artifact_id": {
          "format": "uuid",
          "title": "Source Artifact Id",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "region_id",
        "source_artifact_id",
        "x",
        "y",
        "width",
        "height",
        "canvas_width",
        "canvas_height"
      ],
      "title": "BoundingRegion",
      "type": "object"
    },
    "EntityFieldTarget": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "format": "uuid",
          "title": "Entity Id",
          "type": "string"
        },
        "field_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "target_type": {
          "const": "entity",
          "default": "entity",
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "entity_id"
      ],
      "title": "EntityFieldTarget",
      "type": "object"
    },
    "FieldAnnotation": {
      "additionalProperties": false,
      "properties": {
        "evidence_region_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Region Ids",
          "type": "array"
        },
        "field_annotation_id": {
          "format": "uuid",
          "title": "Field Annotation Id",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "original_extracted_text": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Extracted Text"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "state": {
          "$ref": "#/$defs/ObservationState"
        },
        "target": {
          "$ref": "#/$defs/FieldAnnotationTarget"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnnotationScalar"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "field_annotation_id",
        "target",
        "state"
      ],
      "title": "FieldAnnotation",
      "type": "object"
    },
    "FieldAnnotationTarget": {
      "discriminator": {
        "mapping": {
          "entity": "#/$defs/EntityFieldTarget",
          "field_path": "#/$defs/FieldPathTarget"
        },
        "propertyName": "target_type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FieldPathTarget"
        },
        {
          "$ref": "#/$defs/EntityFieldTarget"
        }
      ]
    },
    "FieldPathTarget": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "maxLength": 1000,
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$",
          "title": "Field Path",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "target_type": {
          "const": "field_path",
          "default": "field_path",
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "field_path"
      ],
      "title": "FieldPathTarget",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "ObservationState": {
      "enum": [
        "present",
        "absent",
        "unknown",
        "ambiguous",
        "not_applicable"
      ],
      "title": "ObservationState",
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "SpatialAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotation_type": {
          "$ref": "#/$defs/SpatialAnnotationType"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "region": {
          "$ref": "#/$defs/BoundingRegion"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "spatial_annotation_id": {
          "format": "uuid",
          "title": "Spatial Annotation Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ObservationState"
        }
      },
      "required": [
        "spatial_annotation_id",
        "annotation_type",
        "state",
        "region"
      ],
      "title": "SpatialAnnotation",
      "type": "object"
    },
    "SpatialAnnotationType": {
      "enum": [
        "figure",
        "panel",
        "blot",
        "lane",
        "protein_row",
        "band",
        "label",
        "quantification_plot"
      ],
      "title": "SpatialAnnotationType",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:annotation-revision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation_id": {
      "format": "uuid",
      "title": "Annotation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error_codes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "title": "Error Codes",
      "type": "array"
    },
    "field_annotations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FieldAnnotation"
      },
      "title": "Field Annotations",
      "type": "array"
    },
    "prior_revision_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prior Revision Id"
    },
    "rationale": {
      "anyOf": [
        {
          "maxLength": 10000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "relationships": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AnnotationRelationship"
      },
      "title": "Relationships",
      "type": "array"
    },
    "reviewer_id": {
      "format": "uuid",
      "title": "Reviewer Id",
      "type": "string"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "revision_number": {
      "minimum": 1,
      "title": "Revision Number",
      "type": "integer"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "spatial_annotations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SpatialAnnotation"
      },
      "title": "Spatial Annotations",
      "type": "array"
    }
  },
  "required": [
    "revision_id",
    "annotation_id",
    "revision_number",
    "reviewer_id",
    "created_at"
  ],
  "title": "AnnotationRevision",
  "type": "object"
}
