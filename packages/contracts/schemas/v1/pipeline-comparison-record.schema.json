{
  "$defs": {
    "ComparisonOutcome": {
      "enum": [
        "regression",
        "unchanged",
        "improvement"
      ],
      "title": "ComparisonOutcome",
      "type": "string"
    },
    "EvaluationCaseComparison": {
      "additionalProperties": false,
      "properties": {
        "baseline_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Baseline Score",
          "type": "number"
        },
        "candidate_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Candidate Score",
          "type": "number"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "delta": {
          "maximum": 1,
          "minimum": -1,
          "title": "Delta",
          "type": "number"
        },
        "outcome": {
          "$ref": "#/$defs/ComparisonOutcome"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "case_id",
        "baseline_score",
        "candidate_score",
        "delta",
        "outcome"
      ],
      "title": "EvaluationCaseComparison",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "PipelineIdentifier": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "version": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "PipelineIdentifier",
      "type": "object"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:pipeline-comparison-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_metric_run_id": {
      "format": "uuid",
      "title": "Baseline Metric Run Id",
      "type": "string"
    },
    "baseline_pipeline": {
      "$ref": "#/$defs/PipelineIdentifier"
    },
    "candidate_metric_run_id": {
      "format": "uuid",
      "title": "Candidate Metric Run Id",
      "type": "string"
    },
    "candidate_pipeline": {
      "$ref": "#/$defs/PipelineIdentifier"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/EvaluationCaseComparison"
      },
      "title": "Cases",
      "type": "array"
    },
    "comparison_id": {
      "format": "uuid",
      "title": "Comparison Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_name": {
      "$ref": "#/$defs/Identifier"
    },
    "dataset_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "dataset_snapshot_id": {
      "format": "uuid",
      "title": "Dataset Snapshot Id",
      "type": "string"
    },
    "dataset_version": {
      "$ref": "#/$defs/Identifier"
    },
    "improvements": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Improvements",
      "type": "array"
    },
    "minimum_delta": {
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Delta",
      "type": "number"
    },
    "overall_delta": {
      "maximum": 1,
      "minimum": -1,
      "title": "Overall Delta",
      "type": "number"
    },
    "regressions": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Regressions",
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    }
  },
  "required": [
    "comparison_id",
    "dataset_snapshot_id",
    "dataset_name",
    "dataset_version",
    "dataset_sha256",
    "baseline_metric_run_id",
    "baseline_pipeline",
    "candidate_metric_run_id",
    "candidate_pipeline",
    "minimum_delta",
    "overall_delta",
    "cases",
    "regressions",
    "improvements",
    "created_at"
  ],
  "title": "PipelineComparisonRecord",
  "type": "object"
}
