{
  "$defs": {
    "Identifier": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "RegressionStatus": {
      "enum": [
        "not_evaluated",
        "stable",
        "improved",
        "regressed"
      ],
      "title": "RegressionStatus",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "in_review",
        "reviewed",
        "needs_adjudication",
        "adjudicated"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:review-queue-filters",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assay_type": {
      "anyOf": [
        {
          "const": "western_blot",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assay Type"
    },
    "confidence_max": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence Max"
    },
    "confidence_min": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence Min"
    },
    "dataset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Id"
    },
    "error_category": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "gold_eligible": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gold Eligible"
    },
    "has_validation_warnings": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Has Validation Warnings"
    },
    "missing_provenance": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing Provenance"
    },
    "model_disagreement": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Disagreement"
    },
    "prediction_version": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "regression_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegressionStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review_statuses": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReviewStatus"
      },
      "title": "Review Statuses",
      "type": "array"
    },
    "reviewer_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer Id"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "source_query": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Query"
    }
  },
  "title": "ReviewQueueFilters",
  "type": "object"
}
