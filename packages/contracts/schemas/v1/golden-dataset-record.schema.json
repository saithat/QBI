{
  "$defs": {
    "GoldenDatasetStatus": {
      "enum": [
        "draft",
        "frozen"
      ],
      "title": "GoldenDatasetStatus",
      "type": "string"
    },
    "GoldenDatasetType": {
      "enum": [
        "development",
        "frozen_test",
        "challenge",
        "shadow",
        "densitometry_reference",
        "retrieval_evaluation"
      ],
      "title": "GoldenDatasetType",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:golden-dataset-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "format": "uuid",
      "title": "Created By",
      "type": "string"
    },
    "dataset_id": {
      "format": "uuid",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_name": {
      "$ref": "#/$defs/Identifier"
    },
    "dataset_type": {
      "$ref": "#/$defs/GoldenDatasetType"
    },
    "dataset_version": {
      "$ref": "#/$defs/Identifier"
    },
    "predecessor_snapshot_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Snapshot Id"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "status": {
      "$ref": "#/$defs/GoldenDatasetStatus"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_name",
    "dataset_version",
    "dataset_type",
    "status",
    "revision",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "title": "GoldenDatasetRecord",
  "type": "object"
}
