{
  "$defs": {
    "Identifier": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "SearchIndexStatus": {
      "enum": [
        "building",
        "ready",
        "active",
        "failed",
        "retired"
      ],
      "title": "SearchIndexStatus",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:search-index-version-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activated At"
    },
    "activation_evaluation_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activation Evaluation Run Id"
    },
    "built_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Built At"
    },
    "configuration_id": {
      "format": "uuid",
      "title": "Configuration Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "format": "uuid",
      "title": "Created By",
      "type": "string"
    },
    "document_count": {
      "minimum": 0,
      "title": "Document Count",
      "type": "integer"
    },
    "evaluated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluated At"
    },
    "failure_reason": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "index_name": {
      "$ref": "#/$defs/Identifier"
    },
    "index_version": {
      "$ref": "#/$defs/Identifier"
    },
    "index_version_id": {
      "format": "uuid",
      "title": "Index Version Id",
      "type": "string"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256Digest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "status": {
      "$ref": "#/$defs/SearchIndexStatus"
    }
  },
  "required": [
    "index_version_id",
    "configuration_id",
    "index_name",
    "index_version",
    "status",
    "document_count",
    "created_by",
    "created_at"
  ],
  "title": "SearchIndexVersionRecord",
  "type": "object"
}
