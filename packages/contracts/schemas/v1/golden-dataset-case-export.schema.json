{
  "$defs": {
    "AdjudicationRecord": {
      "additionalProperties": false,
      "properties": {
        "adjudication_id": {
          "format": "uuid",
          "title": "Adjudication Id",
          "type": "string"
        },
        "adjudicator_id": {
          "format": "uuid",
          "title": "Adjudicator Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "considered_revision_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 2,
          "title": "Considered Revision Ids",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "rationale": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "selected_revision_id": {
          "format": "uuid",
          "title": "Selected Revision Id",
          "type": "string"
        }
      },
      "required": [
        "adjudication_id",
        "case_id",
        "adjudicator_id",
        "selected_revision_id",
        "considered_revision_ids",
        "rationale",
        "created_at"
      ],
      "title": "AdjudicationRecord",
      "type": "object"
    },
    "AnnotationRelationship": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "format": "uuid",
          "title": "Object Id",
          "type": "string"
        },
        "relation_type": {
          "$ref": "#/$defs/Identifier"
        },
        "relationship_id": {
          "format": "uuid",
          "title": "Relationship Id",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "subject_id": {
          "format": "uuid",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "relationship_id",
        "subject_id",
        "relation_type",
        "object_id"
      ],
      "title": "AnnotationRelationship",
      "type": "object"
    },
    "AnnotationRevision": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "format": "uuid",
          "title": "Annotation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Error Codes",
          "type": "array"
        },
        "field_annotations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldAnnotation"
          },
          "title": "Field Annotations",
          "type": "array"
        },
        "prior_revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prior Revision Id"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "relationships": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AnnotationRelationship"
          },
          "title": "Relationships",
          "type": "array"
        },
        "reviewer_id": {
          "format": "uuid",
          "title": "Reviewer Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "spatial_annotations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SpatialAnnotation"
          },
          "title": "Spatial Annotations",
          "type": "array"
        },
        "structured_annotation": {
          "anyOf": [
            {
              "$ref": "#/$defs/WesternBlotStructuredAnnotation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "revision_id",
        "annotation_id",
        "revision_number",
        "reviewer_id",
        "created_at"
      ],
      "title": "AnnotationRevision",
      "type": "object"
    },
    "AnnotationScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "AntibodyAnnotation": {
      "additionalProperties": false,
      "properties": {
        "canonical_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalEntityReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog_number": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Number"
        },
        "clone": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clone"
        },
        "dilution": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dilution"
        },
        "entity_id": {
          "format": "uuid",
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "const": "antibody",
          "default": "antibody",
          "title": "Entity Type",
          "type": "string"
        },
        "evidence_region_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Region Ids",
          "type": "array"
        },
        "host_species": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host Species"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "original_extracted_text": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Extracted Text"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "state": {
          "$ref": "#/$defs/ObservationState",
          "default": "present"
        },
        "vendor": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vendor"
        }
      },
      "required": [
        "entity_id"
      ],
      "title": "AntibodyAnnotation",
      "type": "object"
    },
    "ArtifactAcquisitionMethod": {
      "description": "How immutable bytes entered HiveBlot.",
      "enum": [
        "user_upload",
        "source_adapter",
        "tool_output"
      ],
      "title": "ArtifactAcquisitionMethod",
      "type": "string"
    },
    "ArtifactRecord": {
      "additionalProperties": false,
      "description": "Published metadata for immutable, content-addressed scientific bytes.",
      "properties": {
        "acquisition_method": {
          "$ref": "#/$defs/ArtifactAcquisitionMethod"
        },
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "$ref": "#/$defs/MediaType"
        },
        "organization_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "original_filename": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Original Filename",
          "type": "string"
        },
        "relationships": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRelationship"
          },
          "title": "Relationships",
          "type": "array"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "source_uri": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "visibility": {
          "$ref": "#/$defs/ArtifactVisibility"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "media_type",
        "byte_size",
        "original_filename",
        "acquisition_method",
        "visibility",
        "created_at"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "ArtifactRelationship": {
      "additionalProperties": false,
      "description": "A stable link from an artifact to another immutable artifact.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArtifactRelationshipKind"
        },
        "related_artifact_id": {
          "format": "uuid",
          "title": "Related Artifact Id",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "related_artifact_id",
        "kind"
      ],
      "title": "ArtifactRelationship",
      "type": "object"
    },
    "ArtifactRelationshipKind": {
      "description": "Directed provenance relationship between two artifacts.",
      "enum": [
        "parent",
        "related",
        "derived_from",
        "supplement_to"
      ],
      "title": "ArtifactRelationshipKind",
      "type": "string"
    },
    "ArtifactVisibility": {
      "description": "Visibility attached to artifact metadata and access grants.",
      "enum": [
        "public",
        "organization_private"
      ],
      "title": "ArtifactVisibility",
      "type": "string"
    },
    "BiologicalContextAnnotation": {
      "additionalProperties": false,
      "properties": {
        "canonical_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalEntityReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context_type": {
          "$ref": "#/$defs/BiologicalContextType"
        },
        "entity_id": {
          "format": "uuid",
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "const": "biological_context",
          "default": "biological_context",
          "title": "Entity Type",
          "type": "string"
        },
        "evidence_region_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Region Ids",
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "original_extracted_text": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Extracted Text"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "state": {
          "$ref": "#/$defs/ObservationState",
          "default": "present"
        }
      },
      "required": [
        "entity_id",
        "context_type"
      ],
      "title": "BiologicalContextAnnotation",
      "type": "object"
    },
    "BiologicalContextType": {
      "enum": [
        "cell_line",
        "tissue",
        "organism",
        "genotype"
      ],
      "title": "BiologicalContextType",
      "type": "string"
    },
    "BoundingRegion": {
      "additionalProperties": false,
      "description": "A rectangle expressed in immutable source-image pixel coordinates.",
      "properties": {
        "canvas_height": {
          "exclusiveMinimum": 0,
          "title": "Canvas Height",
          "type": "integer"
        },
        "canvas_width": {
          "exclusiveMinimum": 0,
          "title": "Canvas Width",
          "type": "integer"
        },
        "coordinate_space": {
          "const": "source_pixels",
          "default": "source_pixels",
          "title": "Coordinate Space",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "region_id": {
          "format": "uuid",
          "title": "Region Id",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_artifact_id": {
          "format": "uuid",
          "title": "Source Artifact Id",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "region_id",
        "source_artifact_id",
        "x",
        "y",
        "width",
        "height",
        "canvas_width",
        "canvas_height"
      ],
      "title": "BoundingRegion",
      "type": "object"
    },
    "CanonicalEntityReference": {
      "additionalProperties": false,
      "properties": {
        "accession": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accession"
        },
        "canonical_id": {
          "$ref": "#/$defs/Identifier"
        },
        "entity_type": {
          "$ref": "#/$defs/CanonicalEntityType"
        },
        "label": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "vocabulary": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "entity_type",
        "canonical_id",
        "label",
        "vocabulary"
      ],
      "title": "CanonicalEntityReference",
      "type": "object"
    },
    "CanonicalEntityType": {
      "enum": [
        "protein",
        "cell_line",
        "tissue",
        "organism",
        "treatment",
        "genotype",
        "antibody"
      ],
      "title": "CanonicalEntityType",
      "type": "string"
    },
    "CaseArtifactRole": {
      "enum": [
        "source_document",
        "figure",
        "raw_source",
        "supplementary",
        "context"
      ],
      "title": "CaseArtifactRole",
      "type": "string"
    },
    "EntityFieldTarget": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "format": "uuid",
          "title": "Entity Id",
          "type": "string"
        },
        "field_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "target_type": {
          "const": "entity",
          "default": "entity",
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "entity_id"
      ],
      "title": "EntityFieldTarget",
      "type": "object"
    },
    "FieldAnnotation": {
      "additionalProperties": false,
      "properties": {
        "evidence_region_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Region Ids",
          "type": "array"
        },
        "field_annotation_id": {
          "format": "uuid",
          "title": "Field Annotation Id",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "original_extracted_text": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Extracted Text"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "state": {
          "$ref": "#/$defs/ObservationState"
        },
        "target": {
          "$ref": "#/$defs/FieldAnnotationTarget"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnnotationScalar"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "field_annotation_id",
        "target",
        "state"
      ],
      "title": "FieldAnnotation",
      "type": "object"
    },
    "FieldAnnotationTarget": {
      "discriminator": {
        "mapping": {
          "entity": "#/$defs/EntityFieldTarget",
          "field_path": "#/$defs/FieldPathTarget"
        },
        "propertyName": "target_type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FieldPathTarget"
        },
        {
          "$ref": "#/$defs/EntityFieldTarget"
        }
      ]
    },
    "FieldPathTarget": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "maxLength": 1000,
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$",
          "title": "Field Path",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "target_type": {
          "const": "field_path",
          "default": "field_path",
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "field_path"
      ],
      "title": "FieldPathTarget",
      "type": "object"
    },
    "GoldenCaseProvenance": {
      "additionalProperties": false,
      "properties": {
        "adjudication_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Id"
        },
        "annotation_id": {
          "format": "uuid",
          "title": "Annotation Id",
          "type": "string"
        },
        "evaluation_case_version": {
          "minimum": 1,
          "title": "Evaluation Case Version",
          "type": "integer"
        },
        "prediction_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Prediction Ids",
          "type": "array"
        },
        "promoted_at": {
          "format": "date-time",
          "title": "Promoted At",
          "type": "string"
        },
        "promoted_by": {
          "format": "uuid",
          "title": "Promoted By",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "selected_revision_id": {
          "format": "uuid",
          "title": "Selected Revision Id",
          "type": "string"
        }
      },
      "required": [
        "evaluation_case_version",
        "review_status",
        "prediction_ids",
        "annotation_id",
        "selected_revision_id",
        "promoted_by",
        "promoted_at"
      ],
      "title": "GoldenCaseProvenance",
      "type": "object"
    },
    "GoldenCaseSourceArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRecord"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "role": {
          "$ref": "#/$defs/CaseArtifactRole"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "role",
        "artifact"
      ],
      "title": "GoldenCaseSourceArtifact",
      "type": "object"
    },
    "GoldenDatasetCaseSnapshot": {
      "additionalProperties": false,
      "properties": {
        "adjudication": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdjudicationRecord"
            },
            {
              "type": "null"
            }
          ],
