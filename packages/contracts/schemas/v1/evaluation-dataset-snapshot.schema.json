{
  "$defs": {
    "BoundingRegion": {
      "additionalProperties": false,
      "description": "A rectangle expressed in immutable source-image pixel coordinates.",
      "properties": {
        "canvas_height": {
          "exclusiveMinimum": 0,
          "title": "Canvas Height",
          "type": "integer"
        },
        "canvas_width": {
          "exclusiveMinimum": 0,
          "title": "Canvas Width",
          "type": "integer"
        },
        "coordinate_space": {
          "const": "source_pixels",
          "default": "source_pixels",
          "title": "Coordinate Space",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "region_id": {
          "format": "uuid",
          "title": "Region Id",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_artifact_id": {
          "format": "uuid",
          "title": "Source Artifact Id",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "region_id",
        "source_artifact_id",
        "x",
        "y",
        "width",
        "height",
        "canvas_width",
        "canvas_height"
      ],
      "title": "BoundingRegion",
      "type": "object"
    },
    "EvaluationCaseDimensions": {
      "additionalProperties": false,
      "properties": {
        "assay_layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "journal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_type": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "source_type",
        "review_status"
      ],
      "title": "EvaluationCaseDimensions",
      "type": "object"
    },
    "EvaluationReferenceCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "dimensions": {
          "$ref": "#/$defs/EvaluationCaseDimensions"
        },
        "reference": {
          "$ref": "#/$defs/ReferenceObservationDocument"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "case_id",
        "dimensions",
        "reference"
      ],
      "title": "EvaluationReferenceCase",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "RankingJudgment": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "$ref": "#/$defs/Identifier"
        },
        "query_id": {
          "$ref": "#/$defs/Identifier"
        },
        "relevance": {
          "maximum": 4,
          "minimum": 0,
          "title": "Relevance",
          "type": "integer"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "query_id",
        "item_id",
        "relevance"
      ],
      "title": "RankingJudgment",
      "type": "object"
    },
    "ReferenceFieldObservation": {
      "additionalProperties": false,
      "properties": {
        "evidence_artifact_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Artifact Ids",
          "type": "array"
        },
        "field_path": {
          "maxLength": 1000,
          "pattern": "^(?:/(?:[^/~]|~[01])+)*$",
          "title": "Field Path",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "value_json": {
          "minLength": 1,
          "title": "Value Json",
          "type": "string"
        }
      },
      "required": [
        "field_path",
        "value_json"
      ],
      "title": "ReferenceFieldObservation",
      "type": "object"
    },
    "ReferenceNumericalObservation": {
      "additionalProperties": false,
      "properties": {
        "evidence_artifact_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Artifact Ids",
          "type": "array"
        },
        "field_path": {
          "maxLength": 1000,
          "pattern": "^(?:/(?:[^/~]|~[01])+)*$",
          "title": "Field Path",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "field_path",
        "value"
      ],
      "title": "ReferenceNumericalObservation",
      "type": "object"
    },
    "ReferenceObservationDocument": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReferenceFieldObservation"
          },
          "title": "Fields",
          "type": "array"
        },
        "numerical_values": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReferenceNumericalObservation"
          },
          "title": "Numerical Values",
          "type": "array"
        },
        "ranking_judgments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RankingJudgment"
          },
          "title": "Ranking Judgments",
          "type": "array"
        },
        "regions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReferenceRegionObservation"
          },
          "title": "Regions",
          "type": "array"
        },
        "relationships": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReferenceRelationshipObservation"
          },
          "title": "Relationships",
          "type": "array"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "title": "ReferenceObservationDocument",
      "type": "object"
    },
    "ReferenceRegionObservation": {
      "additionalProperties": false,
      "properties": {
        "annotation_type": {
          "$ref": "#/$defs/SpatialAnnotationType"
        },
        "evidence_artifact_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Artifact Ids",
          "type": "array"
        },
        "region": {
          "$ref": "#/$defs/BoundingRegion"
        },
        "region_key": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "region_key",
        "annotation_type",
        "region"
      ],
      "title": "ReferenceRegionObservation",
      "type": "object"
    },
    "ReferenceRelationshipObservation": {
      "additionalProperties": false,
      "properties": {
        "evidence_artifact_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Artifact Ids",
          "type": "array"
        },
        "object_key": {
          "$ref": "#/$defs/Identifier"
        },
        "relation_type": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "subject_key": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "subject_key",
        "relation_type",
        "object_key"
      ],
      "title": "ReferenceRelationshipObservation",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "in_review",
        "reviewed",
        "needs_adjudication",
        "adjudicated"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "SpatialAnnotationType": {
      "enum": [
        "figure",
        "panel",
        "blot",
        "lane",
        "protein_row",
        "band",
        "label",
        "quantification_plot"
      ],
      "title": "SpatialAnnotationType",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:evaluation-dataset-snapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/EvaluationReferenceCase"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "content_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "dataset_name": {
      "$ref": "#/$defs/Identifier"
    },
    "dataset_version": {
      "$ref": "#/$defs/Identifier"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "snapshot_id": {
      "format": "uuid",
      "title": "Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "dataset_name",
    "dataset_version",
    "content_sha256",
    "frozen_at",
    "cases"
  ],
  "title": "EvaluationDatasetSnapshot",
  "type": "object"
}
