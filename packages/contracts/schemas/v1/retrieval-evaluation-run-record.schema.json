{
  "$defs": {
    "Identifier": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "RetrievalAggregateMetrics": {
      "additionalProperties": false,
      "properties": {
        "citation_correctness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Citation Correctness",
          "type": "number"
        },
        "cross_tenant_leakage_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Cross Tenant Leakage Rate",
          "type": "number"
        },
        "filter_correctness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Filter Correctness",
          "type": "number"
        },
        "mean_reciprocal_rank": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mean Reciprocal Rank",
          "type": "number"
        },
        "ndcg_at_k": {
          "items": {
            "$ref": "#/$defs/RetrievalMetricAtK"
          },
          "title": "Ndcg At K",
          "type": "array"
        },
        "recall_at_k": {
          "items": {
            "$ref": "#/$defs/RetrievalMetricAtK"
          },
          "title": "Recall At K",
          "type": "array"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "recall_at_k",
        "mean_reciprocal_rank",
        "ndcg_at_k",
        "filter_correctness",
        "citation_correctness",
        "cross_tenant_leakage_rate"
      ],
      "title": "RetrievalAggregateMetrics",
      "type": "object"
    },
    "RetrievalEvaluationConfiguration": {
      "additionalProperties": false,
      "properties": {
        "k_values": {
          "default": [
            1,
            5,
            10
          ],
          "items": {
            "type": "integer"
          },
          "title": "K Values",
          "type": "array"
        },
        "maximum_cross_tenant_leakage_rate": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Cross Tenant Leakage Rate",
          "type": "number"
        },
        "minimum_citation_correctness": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Citation Correctness",
          "type": "number"
        },
        "minimum_filter_correctness": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Filter Correctness",
          "type": "number"
        },
        "minimum_recall_at_largest_k": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Recall At Largest K",
          "type": "number"
        },
        "rerank": {
          "default": true,
          "title": "Rerank",
          "type": "boolean"
        },
        "retrieval_mode": {
          "$ref": "#/$defs/RetrievalMode",
          "default": "hybrid"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "title": "RetrievalEvaluationConfiguration",
      "type": "object"
    },
    "RetrievalMetricAtK": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "k",
        "value"
      ],
      "title": "RetrievalMetricAtK",
      "type": "object"
    },
    "RetrievalMode": {
      "enum": [
        "lexical",
        "semantic",
        "hybrid"
      ],
      "title": "RetrievalMode",
      "type": "string"
    },
    "RetrievalQueryMetric": {
      "additionalProperties": false,
      "properties": {
        "citation_correctness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Citation Correctness",
          "type": "number"
        },
        "cross_tenant_leaks": {
          "minimum": 0,
          "title": "Cross Tenant Leaks",
          "type": "integer"
        },
        "filter_correctness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Filter Correctness",
          "type": "number"
        },
        "ndcg_at_k": {
          "items": {
            "$ref": "#/$defs/RetrievalMetricAtK"
          },
          "title": "Ndcg At K",
          "type": "array"
        },
        "query_id": {
          "$ref": "#/$defs/Identifier"
        },
        "recall_at_k": {
          "items": {
            "$ref": "#/$defs/RetrievalMetricAtK"
          },
          "title": "Recall At K",
          "type": "array"
        },
        "reciprocal_rank": {
          "maximum": 1,
          "minimum": 0,
          "title": "Reciprocal Rank",
          "type": "number"
        },
        "retrieved_document_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Retrieved Document Ids",
          "type": "array"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "query_id",
        "retrieved_document_ids",
        "recall_at_k",
        "ndcg_at_k",
        "reciprocal_rank",
        "filter_correctness",
        "citation_correctness",
        "cross_tenant_leaks"
      ],
      "title": "RetrievalQueryMetric",
      "type": "object"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "ToolIdentifier": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tool",
          "default": "tool",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "version": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolIdentifier",
      "type": "object"
    }
  },
  "$id": "urn:hiveblot:schema:v1:retrieval-evaluation-run-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "configuration": {
      "$ref": "#/$defs/RetrievalEvaluationConfiguration"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_id": {
      "format": "uuid",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "evaluation_run_id": {
      "format": "uuid",
      "title": "Evaluation Run Id",
      "type": "string"
    },
    "index_version_id": {
      "format": "uuid",
      "title": "Index Version Id",
      "type": "string"
    },
    "metrics": {
      "$ref": "#/$defs/RetrievalAggregateMetrics"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "query_metrics": {
      "items": {
        "$ref": "#/$defs/RetrievalQueryMetric"
      },
      "title": "Query Metrics",
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "scorer": {
      "$ref": "#/$defs/ToolIdentifier"
    }
  },
  "required": [
    "evaluation_run_id",
    "dataset_id",
    "dataset_sha256",
    "index_version_id",
    "scorer",
    "configuration",
    "metrics",
    "query_metrics",
    "passed",
    "created_at"
  ],
  "title": "RetrievalEvaluationRunRecord",
  "type": "object"
}
