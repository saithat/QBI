{
  "$defs": {
    "ArtifactVisibility": {
      "description": "Visibility attached to artifact metadata and access grants.",
      "enum": [
        "public",
        "organization_private"
      ],
      "title": "ArtifactVisibility",
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:annotation-document",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation_id": {
      "format": "uuid",
      "title": "Annotation Id",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "head_revision_id": {
      "format": "uuid",
      "title": "Head Revision Id",
      "type": "string"
    },
    "organization_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Organization Id"
    },
    "reviewer_id": {
      "format": "uuid",
      "title": "Reviewer Id",
      "type": "string"
    },
    "revision_count": {
      "minimum": 1,
      "title": "Revision Count",
      "type": "integer"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "visibility": {
      "$ref": "#/$defs/ArtifactVisibility",
      "default": "public"
    }
  },
  "required": [
    "annotation_id",
    "case_id",
    "reviewer_id",
    "head_revision_id",
    "revision_count",
    "created_at",
    "updated_at"
  ],
  "title": "AnnotationDocumentRecord",
  "type": "object"
}
