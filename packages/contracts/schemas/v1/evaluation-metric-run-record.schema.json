{
  "$defs": {
    "CalibrationBucket": {
      "additionalProperties": false,
      "properties": {
        "accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Accuracy",
          "type": "number"
        },
        "average_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Average Confidence",
          "type": "number"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "lower_bound": {
          "maximum": 1,
          "minimum": 0,
          "title": "Lower Bound",
          "type": "number"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "upper_bound": {
          "maximum": 1,
          "minimum": 0,
          "title": "Upper Bound",
          "type": "number"
        }
      },
      "required": [
        "lower_bound",
        "upper_bound",
        "count",
        "average_confidence",
        "accuracy"
      ],
      "title": "CalibrationBucket",
      "type": "object"
    },
    "CalibrationCategory": {
      "enum": [
        "field",
        "geometry",
        "relationship",
        "numerical",
        "ranking"
      ],
      "title": "CalibrationCategory",
      "type": "string"
    },
    "CalibrationSummary": {
      "additionalProperties": false,
      "properties": {
        "brier_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Brier Score",
          "type": "number"
        },
        "buckets": {
          "items": {
            "$ref": "#/$defs/CalibrationBucket"
          },
          "title": "Buckets",
          "type": "array"
        },
        "coverage_curve": {
          "items": {
            "$ref": "#/$defs/CoveragePoint"
          },
          "title": "Coverage Curve",
          "type": "array"
        },
        "expected_calibration_error": {
          "maximum": 1,
          "minimum": 0,
          "title": "Expected Calibration Error",
          "type": "number"
        },
        "observations": {
          "minimum": 0,
          "title": "Observations",
          "type": "integer"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "observations",
        "brier_score",
        "expected_calibration_error",
        "buckets",
        "coverage_curve"
      ],
      "title": "CalibrationSummary",
      "type": "object"
    },
    "CitationMetricSummary": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Completeness",
          "type": "number"
        },
        "correct": {
          "minimum": 0,
          "title": "Correct",
          "type": "integer"
        },
        "correctness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Correctness",
          "type": "number"
        },
        "expected": {
          "minimum": 0,
          "title": "Expected",
          "type": "integer"
        },
        "f1": {
          "maximum": 1,
          "minimum": 0,
          "title": "F1",
          "type": "number"
        },
        "predicted": {
          "minimum": 0,
          "title": "Predicted",
          "type": "integer"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "correct",
        "predicted",
        "expected",
        "correctness",
        "completeness",
        "f1"
      ],
      "title": "CitationMetricSummary",
      "type": "object"
    },
    "ConfidenceOutcome": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/CalibrationCategory"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "observation_key": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Observation Key",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "case_id",
        "category",
        "observation_key",
        "confidence",
        "correct"
      ],
      "title": "ConfidenceOutcome",
      "type": "object"
    },
    "CoveragePoint": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "precision": {
          "maximum": 1,
          "minimum": 0,
          "title": "Precision",
          "type": "number"
        },
        "retained": {
          "minimum": 0,
          "title": "Retained",
          "type": "integer"
        },
        "risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Risk",
          "type": "number"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "threshold",
        "retained",
        "coverage",
        "precision",
        "risk"
      ],
      "title": "CoveragePoint",
      "type": "object"
    },
    "EvaluationCaseDimensions": {
      "additionalProperties": false,
      "properties": {
        "assay_layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "journal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_type": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "source_type",
        "review_status"
      ],
      "title": "EvaluationCaseDimensions",
      "type": "object"
    },
    "EvaluationCaseMetricResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "confidence_outcomes": {
          "items": {
            "$ref": "#/$defs/ConfidenceOutcome"
          },
          "title": "Confidence Outcomes",
          "type": "array"
        },
        "dimensions": {
          "$ref": "#/$defs/EvaluationCaseDimensions"
        },
        "metrics": {
          "$ref": "#/$defs/EvaluationMetricSummary"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "case_id",
        "dimensions",
        "metrics",
        "confidence_outcomes"
      ],
      "title": "EvaluationCaseMetricResult",
      "type": "object"
    },
    "EvaluationGroupDimension": {
      "enum": [
        "source_type",
        "journal",
        "repository",
        "image_quality",
        "assay_layout",
        "review_status",
        "model_version",
        "pipeline_version"
      ],
      "title": "EvaluationGroupDimension",
      "type": "string"
    },
    "EvaluationMetricConfiguration": {
      "additionalProperties": false,
      "properties": {
        "bounding_box_iou_threshold": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Bounding Box Iou Threshold",
          "type": "number"
        },
        "calibration_bins": {
          "default": 10,
          "maximum": 100,
          "minimum": 2,
          "title": "Calibration Bins",
          "type": "integer"
        },
        "confidence_thresholds": {
          "default": [
            0.0,
            0.25,
            0.5,
            0.75,
            0.9
          ],
          "items": {
            "type": "number"
          },
          "title": "Confidence Thresholds",
          "type": "array"
        },
        "group_by": {
          "default": [
            "source_type",
            "journal",
            "repository",
            "image_quality",
            "assay_layout",
            "review_status",
            "model_version",
            "pipeline_version"
          ],
          "items": {
            "$ref": "#/$defs/EvaluationGroupDimension"
          },
          "title": "Group By",
          "type": "array"
        },
        "normalized_string_casefold": {
          "default": true,
          "title": "Normalized String Casefold",
          "type": "boolean"
        },
        "numerical_absolute_tolerance": {
          "default": 0.01,
          "minimum": 0,
          "title": "Numerical Absolute Tolerance",
          "type": "number"
        },
        "ranking_k": {
          "default": 10,
          "maximum": 1000,
          "minimum": 1,
          "title": "Ranking K",
          "type": "integer"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "title": "EvaluationMetricConfiguration",
      "type": "object"
    },
    "EvaluationMetricGroupResult": {
      "additionalProperties": false,
      "properties": {
        "calibration": {
          "$ref": "#/$defs/CalibrationSummary"
        },
        "case_count": {
          "minimum": 1,
          "title": "Case Count",
          "type": "integer"
        },
        "dimension": {
          "$ref": "#/$defs/EvaluationGroupDimension"
        },
        "metrics": {
          "$ref": "#/$defs/EvaluationMetricSummary"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "value": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "dimension",
        "value",
        "case_count",
        "metrics",
        "calibration"
      ],
      "title": "EvaluationMetricGroupResult",
      "type": "object"
    },
    "EvaluationMetricSummary": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "$ref": "#/$defs/CitationMetricSummary"
        },
        "composite_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Composite Score",
          "type": "number"
        },
        "fields": {
          "$ref": "#/$defs/FieldMetricSummary"
        },
        "geometry": {
          "$ref": "#/$defs/GeometryMetricSummary"
        },
        "numerical": {
          "$ref": "#/$defs/NumericalMetricSummary"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceMetricSummary"
        },
        "ranking": {
          "$ref": "#/$defs/RankingMetricSummary"
        },
        "relationships": {
          "$ref": "#/$defs/MatchMetricSummary"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "fields",
        "geometry",
        "relationships",
        "citations",
        "provenance",
        "numerical",
        "ranking",
        "composite_score"
      ],
      "title": "EvaluationMetricSummary",
      "type": "object"
    },
    "FieldMetricSummary": {
      "additionalProperties": false,
      "properties": {
        "exact": {
          "$ref": "#/$defs/MatchMetricSummary"
        },
        "normalized": {
          "$ref": "#/$defs/MatchMetricSummary"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "exact",
        "normalized"
      ],
      "title": "FieldMetricSummary",
      "type": "object"
    },
    "GeometryMetricSummary": {
      "additionalProperties": false,
      "properties": {
        "comparable_regions": {
          "minimum": 0,
          "title": "Comparable Regions",
          "type": "integer"
        },
        "match": {
          "$ref": "#/$defs/MatchMetricSummary"
        },
        "mean_iou": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mean Iou",
          "type": "number"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "match",
        "comparable_regions",
        "mean_iou"
      ],
      "title": "GeometryMetricSummary",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "MatchMetricSummary": {
      "additionalProperties": false,
      "properties": {
        "f1": {
          "maximum": 1,
          "minimum": 0,
          "title": "F1",
          "type": "number"
        },
        "false_negative": {
          "minimum": 0,
          "title": "False Negative",
          "type": "integer"
        },
        "false_positive": {
          "minimum": 0,
          "title": "False Positive",
          "type": "integer"
        },
        "precision": {
          "maximum": 1,
          "minimum": 0,
          "title": "Precision",
          "type": "number"
        },
        "recall": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recall",
          "type": "number"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "true_positive": {
          "minimum": 0,
          "title": "True Positive",
          "type": "integer"
        }
      },
      "required": [
        "true_positive",
        "false_positive",
        "false_negative",
        "precision",
        "recall",
        "f1"
      ],
      "title": "MatchMetricSummary",
      "type": "object"
    },
    "ModelIdentifier": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "model",
          "default": "model",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "provider": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "version": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "provider",
        "name",
        "version"
      ],
      "title": "ModelIdentifier",
      "type": "object"
    },
    "NumericalMetricSummary": {
      "additionalProperties": false,
      "properties": {
        "comparable_values": {
          "minimum": 0,
          "title": "Comparable Values",
          "type": "integer"
        },
        "mean_absolute_error": {
          "minimum": 0,
          "title": "Mean Absolute Error",
          "type": "number"
        },
        "mean_relative_error": {
          "minimum": 0,
          "title": "Mean Relative Error",
          "type": "number"
        },
        "root_mean_squared_error": {
          "minimum": 0,
          "title": "Root Mean Squared Error",
          "type": "number"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "within_tolerance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Within Tolerance",
          "type": "number"
        }
      },
      "required": [
        "comparable_values",
        "mean_absolute_error",
        "root_mean_squared_error",
        "mean_relative_error",
        "within_tolerance"
      ],
      "title": "NumericalMetricSummary",
      "type": "object"
    },
    "PipelineIdentifier": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "version": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "PipelineIdentifier",
      "type": "object"
    },
    "ProvenanceMetricSummary": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Completeness",
          "type": "number"
        },
        "observations_with_evidence": {
          "minimum": 0,
          "title": "Observations With Evidence",
          "type": "integer"
        },
        "predicted_observations": {
          "minimum": 0,
          "title": "Predicted Observations",
          "type": "integer"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "predicted_observations",
        "observations_with_evidence",
        "completeness"
      ],
      "title": "ProvenanceMetricSummary",
      "type": "object"
    },
    "RankingMetricSummary": {
      "additionalProperties": false,
      "properties": {
        "mean_reciprocal_rank": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mean Reciprocal Rank",
          "type": "number"
        },
        "ndcg_at_k": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ndcg At K",
          "type": "number"
        },
        "queries": {
          "minimum": 0,
          "title": "Queries",
          "type": "integer"
        },
        "recall_at_k": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recall At K",
          "type": "number"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        }
      },
      "required": [
        "queries",
        "recall_at_k",
        "mean_reciprocal_rank",
        "ndcg_at_k"
      ],
      "title": "RankingMetricSummary",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "in_review",
        "reviewed",
        "needs_adjudication",
        "adjudicated"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "ToolIdentifier": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tool",
          "default": "tool",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "version": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolIdentifier",
      "type": "object"
    }
  },
  "$id": "urn:hiveblot:schema:v1:evaluation-metric-run-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calibration": {
      "$ref": "#/$defs/CalibrationSummary"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/EvaluationCaseMetricResult"
      },
      "title": "Cases",
      "type": "array"
    },
    "configuration": {
      "$ref": "#/$defs/EvaluationMetricConfiguration"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_name": {
      "$ref": "#/$defs/Identifier"
    },
    "dataset_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "dataset_snapshot_id": {
      "format": "uuid",
      "title": "Dataset Snapshot Id",
      "type": "string"
    },
    "dataset_version": {
      "$ref": "#/$defs/Identifier"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/EvaluationMetricGroupResult"
      },
      "title": "Groups",
      "type": "array"
    },
    "input_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "metric_run_id": {
      "format": "uuid",
      "title": "Metric Run Id",
      "type": "string"
    },
    "model_versions": {
      "items": {
        "$ref": "#/$defs/ModelIdentifier"
      },
      "title": "Model Versions",
      "type": "array"
    },
    "overall": {
      "$ref": "#/$defs/EvaluationMetricSummary"
    },
    "pipeline": {
      "$ref": "#/$defs/PipelineIdentifier"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "scorer": {
      "$ref": "#/$defs/ToolIdentifier"
    }
  },
  "required": [
    "metric_run_id",
    "dataset_snapshot_id",
    "dataset_name",
    "dataset_version",
    "dataset_sha256",
    "scorer",
    "pipeline",
    "model_versions",
    "configuration",
    "input_sha256",
    "overall",
    "calibration",
    "groups",
    "cases",
    "created_at"
  ],
  "title": "EvaluationMetricRunRecord",
  "type": "object"
}
