{
  "$defs": {
    "ArtifactVisibility": {
      "description": "Visibility attached to artifact metadata and access grants.",
      "enum": [
        "public",
        "organization_private"
      ],
      "title": "ArtifactVisibility",
      "type": "string"
    },
    "ReviewerAssignmentStatus": {
      "enum": [
        "assigned",
        "released",
        "completed"
      ],
      "title": "ReviewerAssignmentStatus",
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:reviewer-assignment",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assigned_at": {
      "format": "date-time",
      "title": "Assigned At",
      "type": "string"
    },
    "assignment_id": {
      "format": "uuid",
      "title": "Assignment Id",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "exclusive": {
      "title": "Exclusive",
      "type": "boolean"
    },
    "organization_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Organization Id"
    },
    "reviewer_id": {
      "format": "uuid",
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "status": {
      "$ref": "#/$defs/ReviewerAssignmentStatus"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "visibility": {
      "$ref": "#/$defs/ArtifactVisibility",
      "default": "public"
    }
  },
  "required": [
    "assignment_id",
    "case_id",
    "reviewer_id",
    "exclusive",
    "status",
    "version",
    "assigned_at",
    "updated_at"
  ],
  "title": "ReviewerAssignment",
  "type": "object"
}
