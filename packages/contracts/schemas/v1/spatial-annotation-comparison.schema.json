{
  "$defs": {
    "BoundingRegion": {
      "additionalProperties": false,
      "description": "A rectangle expressed in immutable source-image pixel coordinates.",
      "properties": {
        "canvas_height": {
          "exclusiveMinimum": 0,
          "title": "Canvas Height",
          "type": "integer"
        },
        "canvas_width": {
          "exclusiveMinimum": 0,
          "title": "Canvas Width",
          "type": "integer"
        },
        "coordinate_space": {
          "const": "source_pixels",
          "default": "source_pixels",
          "title": "Coordinate Space",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "region_id": {
          "format": "uuid",
          "title": "Region Id",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_artifact_id": {
          "format": "uuid",
          "title": "Source Artifact Id",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "region_id",
        "source_artifact_id",
        "x",
        "y",
        "width",
        "height",
        "canvas_width",
        "canvas_height"
      ],
      "title": "BoundingRegion",
      "type": "object"
    },
    "GeometryDiffStatus": {
      "enum": [
        "added",
        "removed",
        "modified",
        "unchanged"
      ],
      "title": "GeometryDiffStatus",
      "type": "string"
    },
    "ObservationState": {
      "enum": [
        "present",
        "absent",
        "unknown",
        "ambiguous",
        "not_applicable"
      ],
      "title": "ObservationState",
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "SpatialAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotation_type": {
          "$ref": "#/$defs/SpatialAnnotationType"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "region": {
          "$ref": "#/$defs/BoundingRegion"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "spatial_annotation_id": {
          "format": "uuid",
          "title": "Spatial Annotation Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ObservationState"
        }
      },
      "required": [
        "spatial_annotation_id",
        "annotation_type",
        "state",
        "region"
      ],
      "title": "SpatialAnnotation",
      "type": "object"
    },
    "SpatialAnnotationDelta": {
      "additionalProperties": false,
      "properties": {
        "annotation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpatialAnnotation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "changed_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Changed Fields",
          "type": "array"
        },
        "prediction": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpatialAnnotation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "spatial_annotation_id": {
          "format": "uuid",
          "title": "Spatial Annotation Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GeometryDiffStatus"
        }
      },
      "required": [
        "spatial_annotation_id",
        "status"
      ],
      "title": "SpatialAnnotationDelta",
      "type": "object"
    },
    "SpatialAnnotationType": {
      "enum": [
        "figure",
        "panel",
        "blot",
        "lane",
        "protein_row",
        "band",
        "label",
        "quantification_plot"
      ],
      "title": "SpatialAnnotationType",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:spatial-annotation-comparison",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "added_count": {
      "minimum": 0,
      "title": "Added Count",
      "type": "integer"
    },
    "annotation_revision_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annotation Revision Id"
    },
    "deltas": {
      "items": {
        "$ref": "#/$defs/SpatialAnnotationDelta"
      },
      "title": "Deltas",
      "type": "array"
    },
    "modified_count": {
      "minimum": 0,
      "title": "Modified Count",
      "type": "integer"
    },
    "prediction_id": {
      "format": "uuid",
      "title": "Prediction Id",
      "type": "string"
    },
    "removed_count": {
      "minimum": 0,
      "title": "Removed Count",
      "type": "integer"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "unchanged_count": {
      "minimum": 0,
      "title": "Unchanged Count",
      "type": "integer"
    }
  },
  "required": [
    "prediction_id",
    "deltas",
    "added_count",
    "removed_count",
    "modified_count",
    "unchanged_count"
  ],
  "title": "SpatialAnnotationComparison",
  "type": "object"
}
