{
  "$defs": {
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "$id": "urn:hiveblot:schema:v1:adjudication-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adjudication_id": {
      "format": "uuid",
      "title": "Adjudication Id",
      "type": "string"
    },
    "adjudicator_id": {
      "format": "uuid",
      "title": "Adjudicator Id",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "considered_revision_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 2,
      "title": "Considered Revision Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "rationale": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "selected_revision_id": {
      "format": "uuid",
      "title": "Selected Revision Id",
      "type": "string"
    }
  },
  "required": [
    "adjudication_id",
    "case_id",
    "adjudicator_id",
    "selected_revision_id",
    "considered_revision_ids",
    "rationale",
    "created_at"
  ],
  "title": "AdjudicationRecord",
  "type": "object"
}
