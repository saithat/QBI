# Copy to .env for a local Docker Compose environment. Never put deployed secrets here.
HIVEBLOT_ENV=local
HF_CACHE_DIR=/path/to/huggingface-cache

# Local-only database credentials used by Docker Compose.
POSTGRES_DB=hiveblot
POSTGRES_USER=hiveblot
POSTGRES_PASSWORD=hiveblot
DATABASE_URL=postgresql://hiveblot:hiveblot@localhost:5432/hiveblot

# Local S3-compatible immutable artifact storage.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hiveblot-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
ARTIFACT_SIGNED_URL_SECONDS=900
ARTIFACT_UPLOAD_URL_SECONDS=3600
ARTIFACT_MAX_BYTES=1073741824
# Comma-separated, exact host allowlist. Empty disables HTTP source ingestion.
SOURCE_INGEST_ALLOWED_HOSTS=

# Local vLLM endpoint and extraction tuning for a 24 GB GPU.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Use an immutable Hub commit or equivalent deployed model revision.
VLLM_MODEL_REVISION=local-cache-unpinned
VLLM_API_KEY=local
VLLM_TIMEOUT_SECONDS=300
VLLM_MAX_TOKENS=4096
VLLM_IMAGE_MAX_SIDE=1800
HIVEBLOT_DATA_DIR=data
PDF_DPI=350
MIN_CANDIDATE_SCORE=0.35
MIN_VLM_SCORE=0.65
