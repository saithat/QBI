# Host path containing models--Qwen--Qwen3-VL-8B-Instruct.
HF_CACHE_DIR=/home/saithat/.cache/huggingface

# Local-only database credentials.
POSTGRES_DB=hiveblot
POSTGRES_USER=hiveblot
POSTGRES_PASSWORD=hiveblot

# Inference and PDF extraction tuning for a 24 GB RTX 3090.
VLLM_TIMEOUT_SECONDS=300
VLLM_MAX_TOKENS=2048
VLLM_IMAGE_MAX_SIDE=1800
PDF_DPI=350
MIN_CANDIDATE_SCORE=0.35
MIN_VLM_SCORE=0.65
