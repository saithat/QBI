# Run `make local-env` to generate a private .env from this credential-free template.
# Never put deployed secrets here.
HIVEBLOT_ENV=local
HF_CACHE_DIR=/path/to/huggingface-cache

# Local-only database settings used by Docker Compose.
POSTGRES_DB=hiveblot
POSTGRES_USER=hiveblot
POSTGRES_PASSWORD=
DATABASE_URL=

# Local S3-compatible immutable artifact storage.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hiveblot-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ARTIFACT_SIGNED_URL_SECONDS=900
ARTIFACT_UPLOAD_URL_SECONDS=3600
ARTIFACT_MAX_BYTES=1073741824
# Comma-separated, exact host allowlist. Empty disables HTTP source ingestion.
SOURCE_INGEST_ALLOWED_HOSTS=

# API-first public source discovery. Identify a monitored contact or project URL.
PMC_OAI_BASE_URL=https://pmc.ncbi.nlm.nih.gov/api/oai/v1/mh/
DISCOVERY_USER_AGENT=HiveBlot local development (contact not configured)
DISCOVERY_HTTP_TIMEOUT_SECONDS=30
DISCOVERY_MAX_RESPONSE_BYTES=5000000
DISCOVERY_LOOKBACK_DAYS=2
DISCOVERY_MAXIMUM_PAGES=20

# Queue-backed public fetch workers. Limits are shared per source domain in PostgreSQL.
FETCH_ALLOWED_HOSTS=pmc.ncbi.nlm.nih.gov
FETCH_WORKER_ID=fetch-worker-local
FETCH_WORKER_POLL_SECONDS=1
FETCH_LEASE_SECONDS=120
FETCH_MAX_ATTEMPTS=5
FETCH_HTTP_TIMEOUT_SECONDS=30
FETCH_MAX_RESPONSE_BYTES=250000000
FETCH_MAX_REDIRECTS=5
FETCH_DOMAIN_MINIMUM_INTERVAL_MILLISECONDS=1000
FETCH_DOMAIN_MAXIMUM_CONCURRENCY=2
FETCH_DOMAIN_PERMIT_SECONDS=60
FETCH_DOMAIN_MAXIMUM_WAIT_SECONDS=30
FETCH_ROBOTS_CACHE_SECONDS=86400
FETCH_ROBOTS_MAX_BYTES=524288

# Domain-independent local job worker. Container environments are empty unless
# a submitted job explicitly allowlists a variable and the worker supplies it.
JOB_LEASE_SECONDS=60
JOB_WORKER_POLL_SECONDS=1.0
JOB_WORKER_ID=local-worker
JOB_EXECUTOR=local-docker
JOB_DOCKER_BINARY=docker
JOB_MAX_LOG_BYTES=262144
JOB_MAX_OUTPUT_BYTES=1073741824

# Kubernetes executor settings are read only when JOB_EXECUTOR=kubernetes-job.
KUBERNETES_JOB_NAMESPACE=hiveblot
KUBERNETES_WORKSPACE_PVC=hiveblot-job-workspaces
KUBERNETES_WORKSPACE_ROOT=/var/lib/hiveblot/jobs
KUBERNETES_JOB_SERVICE_ACCOUNT=hiveblot-job-runner
KUBERNETES_POLL_SECONDS=1
KUBERNETES_API_TIMEOUT_SECONDS=15
KUBERNETES_JOB_TTL_SECONDS=3600
# Optional GPU-only placement settings.
KUBERNETES_GPU_NODE_SELECTOR_KEY=
KUBERNETES_GPU_NODE_SELECTOR_VALUE=
KUBERNETES_GPU_TOLERATION_KEY=
KUBERNETES_GPU_TOLERATION_EFFECT=NoSchedule

# Local vLLM endpoint and extraction tuning for a 24 GB GPU.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Use an immutable Hub commit or equivalent deployed model revision.
VLLM_MODEL_REVISION=local-cache-unpinned
VLLM_API_KEY=
VLLM_TIMEOUT_SECONDS=300
VLLM_MAX_TOKENS=4096
VLLM_IMAGE_MAX_SIDE=1800
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hiveblot-platform-v1
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
HIVEBLOT_DATA_DIR=data
PDF_DPI=350
MIN_CANDIDATE_SCORE=0.35
MIN_VLM_SCORE=0.65
