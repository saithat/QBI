# `make local-env` creates .env with a random database password.
POSTGRES_DB=hiveblot
POSTGRES_USER=hiveblot
POSTGRES_PASSWORD=
DATABASE_URL=
HIVEBLOT_DATA_DIR=data

# Needed only for maintainer ingestion. The public catalog does not call the model.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
VLLM_MODEL_REVISION=local-cache-unpinned
VLLM_API_KEY=
VLLM_TIMEOUT_SECONDS=300
VLLM_MAX_TOKENS=4096
VLLM_IMAGE_MAX_SIDE=1800
PDF_DPI=350
MIN_CANDIDATE_SCORE=0.35
MIN_VLM_SCORE=0.65

# Optional local GPU service: path to the pre-downloaded Hugging Face model cache.
HF_CACHE_DIR=/path/to/huggingface-cache
