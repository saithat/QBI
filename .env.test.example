# Explicit isolated test profile. Copy to a temporary env file; do not reuse deployed data.
HIVEBLOT_ENV=test
DATABASE_URL=
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=test-model
VLLM_API_KEY=
HIVEBLOT_DATA_DIR=/tmp/hiveblot-test-data
S3_ENDPOINT_URL=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=hiveblot-test-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
JOB_EXECUTOR=local-docker
KUBERNETES_JOB_NAMESPACE=hiveblot-test
KUBERNETES_WORKSPACE_PVC=hiveblot-test-workspaces
KUBERNETES_WORKSPACE_ROOT=/tmp/hiveblot-test-jobs
KUBERNETES_JOB_SERVICE_ACCOUNT=hiveblot-job-runner
TEMPORAL_ADDRESS=localhost:7234
TEMPORAL_NAMESPACE=test
TEMPORAL_TASK_QUEUE=hiveblot-test-v1
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
SOURCE_INGEST_ALLOWED_HOSTS=source.test
PMC_OAI_BASE_URL=https://pmc.ncbi.nlm.nih.gov/api/oai/v1/mh/
DISCOVERY_USER_AGENT=HiveBlot test suite (contact: repository tests)
DISCOVERY_HTTP_TIMEOUT_SECONDS=5
DISCOVERY_MAX_RESPONSE_BYTES=1000000
DISCOVERY_LOOKBACK_DAYS=1
DISCOVERY_MAXIMUM_PAGES=2
FETCH_ALLOWED_HOSTS=source.test,127.0.0.1
FETCH_WORKER_ID=fetch-worker-test
FETCH_WORKER_POLL_SECONDS=0.01
FETCH_LEASE_SECONDS=30
FETCH_MAX_ATTEMPTS=3
FETCH_HTTP_TIMEOUT_SECONDS=5
FETCH_MAX_RESPONSE_BYTES=1000000
FETCH_MAX_REDIRECTS=2
FETCH_DOMAIN_MINIMUM_INTERVAL_MILLISECONDS=10
FETCH_DOMAIN_MAXIMUM_CONCURRENCY=1
FETCH_DOMAIN_PERMIT_SECONDS=10
FETCH_DOMAIN_MAXIMUM_WAIT_SECONDS=5
FETCH_ROBOTS_CACHE_SECONDS=300
FETCH_ROBOTS_MAX_BYTES=65536
